# Docker override (local dev only — disables NATS auth)
docker-compose.override.yml

# Replay logs (generated at runtime)
replay/
# Allow the canonical replay fixture used by the nightly regression
# harness (task 59.1). Everything under `tests/fixtures/replay/` is
# committed source — only the on-disk recorder output under the
# top-level `replay/` directory is generated and ignored.
!tests/fixtures/replay/
!tests/fixtures/replay/**

# Logs
*.log
gateway_*.txt
logs/binance/

# Binance helper scripts
_launch_binance_service.cmd

# NATS — generated operator/account JWT artefacts. The committed files
# are placeholders; running docker/nats/provision-creds.sh produces real
# JWTs that must NOT be committed.
docker/nats/generated/

# Ruff cache
.ruff_cache/

# Data and generated files (ignored to prevent repo bloat)
*.csv
.coverage
screenshot_puppeteer.png
synthetic_test.png
ui/dom_output*.html
test_puppeteer.js
node_modules/
