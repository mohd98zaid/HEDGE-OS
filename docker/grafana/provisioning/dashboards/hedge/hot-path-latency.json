            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 3000000}
            ]
          },
          "custom": {"thresholdsStyle": {"mode": "line"}, "lineWidth": 2, "fillOpacity": 10}
