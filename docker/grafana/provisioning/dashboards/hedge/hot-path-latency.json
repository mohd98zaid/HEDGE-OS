    {
      "id": 5,
      "type": "timeseries",
      "title": "Position Update p99 (ns) — proxy via broker submit round-trip",
      "description": "Per-broker submit round-trip (hedge_broker_latency_ns{broker=~\"$broker\"}). The Position_Engine update budget is part of the end-to-end 50 ms ceiling; this panel is the closest available signal until a dedicated histogram lands.",
      "datasource": {"type": "prometheus", "uid": "hedge-prometheus"},
      "editable": false,
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (broker, le) (rate(hedge_broker_latency_ns_bucket{broker=~\"$broker\"}[1m])))",
          "legendFormat": "{{broker}} p99",
          "datasource": {"type": "prometheus", "uid": "hedge-prometheus"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "custom": {"lineWidth": 2, "fillOpacity": 5}
        },
        "overrides": []
