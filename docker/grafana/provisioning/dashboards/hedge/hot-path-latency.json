    {
      "id": 6,
      "type": "timeseries",
      "title": "Per-stage budget breach rate (R28.6)",
      "description": "rate(hedge_budget_breach_total{stage=~\"$component\"}[1m]) per stage — non-zero values indicate the stage exceeded its configured budget.",
      "datasource": {"type": "prometheus", "uid": "hedge-prometheus"},
      "editable": false,
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(hedge_budget_breach_total{stage=~\"$component\"}[1m]))",
          "legendFormat": "{{stage}}",
          "datasource": {"type": "prometheus", "uid": "hedge-prometheus"}
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "ops", "custom": {"lineWidth": 2, "fillOpacity": 10}},
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    }
