# syntax=docker/dockerfile:1.7
# Multi-stage build for the Signal_Engine (Hot_Path).

ARG RUST_VERSION=1.78
ARG DEBIAN_VERSION=bookworm-slim

FROM rust:${RUST_VERSION}-bookworm AS builder
WORKDIR /workspace
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        pkg-config libssl-dev ca-certificates flatbuffers-compiler \
 && rm -rf /var/lib/apt/lists/*
COPY . .
RUN cargo build --release -p hedge-signals --bin hedge-signals

FROM debian:${DEBIAN_VERSION} AS runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tini \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10004 --no-create-home hedge
USER hedge
COPY --from=builder /workspace/target/release/hedge-signals /usr/local/bin/hedge-signals
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/hedge-signals"]
