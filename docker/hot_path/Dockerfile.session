# syntax=docker/dockerfile:1.7
# Multi-stage build for the Session manager (Hot_Path-adjacent).

ARG RUST_VERSION=1.78
ARG DEBIAN_VERSION=bookworm-slim

FROM rust:${RUST_VERSION}-bookworm AS builder
WORKDIR /workspace
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        pkg-config libssl-dev ca-certificates flatbuffers-compiler \
 && rm -rf /var/lib/apt/lists/*
COPY . .
RUN cargo build --release -p hedge-session --bin hedge-session

FROM debian:${DEBIAN_VERSION} AS runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tini tzdata \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10010 --no-create-home hedge
USER hedge
ENV TZ=Asia/Kolkata
COPY --from=builder /workspace/target/release/hedge-session /usr/local/bin/hedge-session
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/hedge-session"]
