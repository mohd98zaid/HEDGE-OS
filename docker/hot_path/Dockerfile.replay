# syntax=docker/dockerfile:1.7
# Multi-stage build for the Replay_Engine.

ARG RUST_VERSION=1.78
ARG DEBIAN_VERSION=bookworm-slim

FROM rust:${RUST_VERSION}-bookworm AS builder
WORKDIR /workspace
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        pkg-config libssl-dev ca-certificates flatbuffers-compiler \
 && rm -rf /var/lib/apt/lists/*
COPY . .
RUN cargo build --release -p hedge-replay --bin hedge-replay

FROM debian:${DEBIAN_VERSION} AS runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tini \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10009 --no-create-home hedge
USER hedge
COPY --from=builder /workspace/target/release/hedge-replay /usr/local/bin/hedge-replay
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/hedge-replay"]
