{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedge.local/schemas/trader_intent_priority.schema.json",
  "title": "trader.intent.priority",
  "description": "Trader-issued symbol priority change. Subject: trader.intent.priority. Producer: ui-gateway. Consumer: Risk_Engine.",
  "type": "object",
  "additionalProperties": false,
  "required": ["correlation_id", "symbol", "to", "actor", "ts_ns"],
  "properties": {
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "symbol":         { "type": "string", "minLength": 1, "maxLength": 32 },
    "to":             { "type": "string", "enum": ["P1", "P2", "P3", "P4"] },
    "actor":          { "type": "string", "minLength": 1, "maxLength": 64 },
    "ts_ns":          { "type": "integer", "minimum": 0 }
  }
}