{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedge.local/schemas/ai_priority_changed.schema.json",
  "title": "ai.priority.changed.<symbol>",
  "description": "Symbol_Priority_Engine edge-triggered priority change. Subject: ai.priority.changed.<sym>. Producer: Warm_AI_Pipeline. Consumers: Hot_Path via WarmCache, UI.",
  "type": "object",
  "additionalProperties": false,
  "required": ["symbol", "from", "to", "ts_ns"],
  "properties": {
    "symbol": { "type": "string", "minLength": 1, "maxLength": 32 },
    "from":   { "type": "string", "enum": ["P1", "P2", "P3", "P4"] },
    "to":     { "type": "string", "enum": ["P1", "P2", "P3", "P4"] },
    "ts_ns":  { "type": "integer", "minimum": 0 }
  }
}