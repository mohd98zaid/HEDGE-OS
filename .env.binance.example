# ============================================================================
# PROJECT HEDGE — Binance Crypto Module Environment Variables
# ============================================================================
#
#  IMPORTANT: This file is intentionally separate from .env (Indian stocks).
#  start-binance.bat loads ONLY this file, never .env.
#
#  Copy to .env.binance and fill in your credentials:
#    copy .env.binance.example .env.binance
#
# ============================================================================

# ── Binance API Credentials ─────────────────────────────────────────────────
# Get from: https://www.binance.com/en/my/settings/api-management
# Permissions needed: Read Info + Spot Trading (do NOT enable Withdraw)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ── Testnet Mode ────────────────────────────────────────────────────────────
# true  → testnet.binance.vision  (safe, fake funds, always start here)
# false → api.binance.com         (REAL MONEY — only after testnet works)
BINANCE_TESTNET=true

# ── Trading Symbols ─────────────────────────────────────────────────────────
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT

# ── Trade Type ──────────────────────────────────────────────────────────────
BINANCE_TRADE_TYPE=spot

# ── Risk Limits ─────────────────────────────────────────────────────────────
# Max open notional (USDT) per symbol
BINANCE_MAX_POSITION_USDT=500
# Daily loss cut-off — all trading halts when daily PnL < -LIMIT
BINANCE_DAILY_LOSS_LIMIT=100
# Max concurrent open orders
BINANCE_MAX_OPEN_ORDERS=5
# Max trades per calendar day (circuit breaker)
BINANCE_MAX_DAILY_TRADES=20
# Pause trading after N consecutive losing trades for 15 minutes
BINANCE_MAX_CONSEC_LOSSES=3
# Reject signals whose quality score is below this threshold (0-100)
BINANCE_MIN_SIGNAL_SCORE=30

# ── Strategy: EMA Crossover ─────────────────────────────────────────────────
BINANCE_EMA_FAST=9
BINANCE_EMA_SLOW=21

# ── Strategy: RSI Filter ────────────────────────────────────────────────────
# Only buy when RSI < RSI_BUY_MAX (not overbought)
# Only sell when RSI > RSI_SELL_MIN (not oversold)
BINANCE_RSI_PERIOD=14
BINANCE_RSI_BUY_MAX=65
BINANCE_RSI_SELL_MIN=35

# ── Strategy: ATR-Based Stop-Loss / Take-Profit ─────────────────────────────
# Stop-loss  = entry_price ± (ATR × ATR_SL_MULT)
# Take-profit= entry_price ± (ATR × ATR_TP_MULT)
# Ratio ATR_TP_MULT / ATR_SL_MULT = Risk:Reward ratio
# Default: 3.0 / 1.5 = 2:1 R:R (take-profit 2× bigger than stop-loss)
BINANCE_ATR_PERIOD=14
BINANCE_ATR_SL_MULT=1.5
BINANCE_ATR_TP_MULT=3.0

# ── Strategy: Volume Confirmation ───────────────────────────────────────────
# Only trade when volume > avg × VOL_SURGE (filters false breakouts)
BINANCE_VOL_SURGE=1.5

# ── Strategy: Signal Cooldown ───────────────────────────────────────────────
# Minimum seconds between signals per symbol (avoids whipsawing)
BINANCE_COOLDOWN_S=300

# ── Strategy: Order Size ────────────────────────────────────────────────────
# Notional size per MARKET order (USDT)
BINANCE_QTY_USDT=50

# ── Strategy: Spread Filter ─────────────────────────────────────────────────
# Skip when bid-ask spread > this % (illiquid / high-slippage protection)
BINANCE_MIN_SPREAD=0.05

# ── Position Tracker ────────────────────────────────────────────────────────
# How often to poll Binance REST API for account balances (seconds)
BINANCE_POSITION_POLL_S=10
