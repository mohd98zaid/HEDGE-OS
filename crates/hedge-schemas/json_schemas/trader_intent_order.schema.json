{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedge.local/schemas/trader_intent_order.schema.json",
  "title": "trader.intent.order",
  "description": "Trader-issued manual order intent. Subject: trader.intent.order. Producer: ui-gateway. Consumer: Risk_Engine.",
  "type": "object",
  "additionalProperties": false,
  "required": ["correlation_id", "symbol", "side", "quantity", "order_type", "exchange", "actor", "ts_ns"],
  "properties": {
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "symbol":         { "type": "string", "minLength": 1, "maxLength": 32 },
    "side":           { "type": "string", "enum": ["Buy", "Sell"] },
    "quantity":       { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "order_type":     { "type": "string", "enum": ["Market", "Limit"] },
    "limit_paise":    { "type": "integer" },
    "exchange":       { "type": "string", "enum": ["NSE", "BSE"] },
    "actor":          { "type": "string", "minLength": 1, "maxLength": 64 },
    "ts_ns":          { "type": "integer", "minimum": 0 }
  },
  "allOf": [
    {
      "if":   { "properties": { "order_type": { "const": "Limit" } } },
      "then": { "required": ["limit_paise"] }
    }
  ]
}