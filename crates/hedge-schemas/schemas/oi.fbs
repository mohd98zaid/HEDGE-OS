// OpenInterest_v1: per-symbol futures/options OI snapshot (R1.5).
// Layer: Hot_Path. Producer: Market_Data_Engine. Wire: NATS `md.oi.<sym>`.

namespace hedge.v1;

table OpenInterest_v1 {
  correlation_id: [ubyte:16];
  symbol: uint;
  oi_total: ulong;
  oi_change: long;
  ts_ns: ulong;
}

root_type OpenInterest_v1;
file_identifier "HEDG";
