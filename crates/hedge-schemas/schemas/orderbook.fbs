// OrderBook_v1: level-2 order book up to 20 levels (R1.5).
// Layer: Hot_Path. Producer: Market_Data_Engine. Wire: NATS `md.book.<sym>`.

namespace hedge.v1;

struct BookLevel {
  price_paise: long;
  qty: ulong;
  orders: uint;
}

table OrderBook_v1 {
  correlation_id: [ubyte:16];
  symbol: uint;
  exchange: byte;          // 0 = NSE, 1 = BSE
  bid_levels: [BookLevel];   // up to 20 entries
  ask_levels: [BookLevel];   // up to 20 entries
  ts_ns: ulong;
}

root_type OrderBook_v1;
file_identifier "HEDG";
